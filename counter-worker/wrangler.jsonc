{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cskaoyan-card-clicks",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "CARD_CLICK_RATE_LIMIT",
      "namespace_id": "917301",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "CARD_IP_RATE_LIMIT",
      "namespace_id": "917302",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cskaoyan-card-clicks",
      "database_id": "ad401723-db8c-4b49-a40f-d7fe3b74e67f"
    }
  ]
}
